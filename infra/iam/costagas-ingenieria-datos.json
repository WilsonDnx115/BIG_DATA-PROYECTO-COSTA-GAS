{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StacksDelProyecto",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": "arn:aws:cloudformation:us-east-2:*:stack/costagas-*/*"
    },
    {
      "Sid": "ValidarYListarStacks",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ValidateTemplate",
        "cloudformation:ListStacks",
        "cloudformation:GetTemplateSummary",
        "cloudformation:DescribeStacks"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LagoYCodigo",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::costagas-trujillo-lake-*",
        "arn:aws:s3:::costagas-trujillo-lake-*/*",
        "arn:aws:s3:::costagas-code-*",
        "arn:aws:s3:::costagas-code-*/*",
        "arn:aws:s3:::costagas-portal-*",
        "arn:aws:s3:::costagas-portal-*/*"
      ]
    },
    {
      "Sid": "ListarBuckets",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    },
    {
      "Sid": "FuncionesDelProyecto",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": "arn:aws:lambda:us-east-2:*:function:costagas-*"
    },
    {
      "Sid": "CapasYListado",
      "Effect": "Allow",
      "Action": [
        "lambda:GetLayerVersion",
        "lambda:ListFunctions",
        "lambda:ListLayers"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GlueJobsYCatalogo",
      "Effect": "Allow",
      "Action": "glue:*",
      "Resource": "*"
    },
    {
      "Sid": "AthenaWorkgroup",
      "Effect": "Allow",
      "Action": "athena:*",
      "Resource": "arn:aws:athena:us-east-2:*:workgroup/costagas-wg"
    },
    {
      "Sid": "ListarAthena",
      "Effect": "Allow",
      "Action": [
        "athena:ListWorkGroups",
        "athena:ListDataCatalogs",
        "athena:GetDataCatalog",
        "athena:ListDatabases",
        "athena:GetDatabase",
        "athena:ListTableMetadata",
        "athena:GetTableMetadata"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SalDeSeudonimizacion",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:PutParameter",
        "ssm:DeleteParameter",
        "ssm:AddTagsToResource"
      ],
      "Resource": "arn:aws:ssm:us-east-2:*:parameter/costagas/*"
    },
    {
      "Sid": "ListarParametros",
      "Effect": "Allow",
      "Action": "ssm:DescribeParameters",
      "Resource": "*"
    },
    {
      "Sid": "RolesDeServicioDelProyecto",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": "arn:aws:iam::*:role/costagas-*"
    },
    {
      "Sid": "EntregarRolesSoloASusServicios",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/costagas-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "lambda.amazonaws.com",
            "glue.amazonaws.com",
            "events.amazonaws.com",
            "scheduler.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "PresupuestoYCostos",
      "Effect": "Allow",
      "Action": [
        "budgets:*",
        "ce:Get*",
        "ce:Describe*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LeerLogs",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents",
        "logs:StartQuery",
        "logs:GetQueryResults"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EventosYProgramas",
      "Effect": "Allow",
      "Action": [
        "events:*",
        "scheduler:*"
      ],
      "Resource": [
        "arn:aws:events:us-east-2:*:rule/costagas-*",
        "arn:aws:scheduler:us-east-2:*:schedule/default/costagas-*",
        "arn:aws:scheduler:us-east-2:*:schedule-group/default"
      ]
    },
    {
      "Sid": "AvisosYColas",
      "Effect": "Allow",
      "Action": [
        "sns:*",
        "sqs:*"
      ],
      "Resource": [
        "arn:aws:sns:us-east-2:*:costagas-*",
        "arn:aws:sqs:us-east-2:*:costagas-*"
      ]
    },
    {
      "Sid": "Alarmas",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:TagResource",
        "cloudwatch:ListTagsForResource"
      ],
      "Resource": "arn:aws:cloudwatch:us-east-2:*:alarm:costagas-*"
    },
    {
      "Sid": "PortalWeb",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:*",
        "cloudfront:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ProveedorOidcGithub",
      "Effect": "Allow",
      "Action": [
        "iam:CreateOpenIDConnectProvider",
        "iam:GetOpenIDConnectProvider",
        "iam:DeleteOpenIDConnectProvider",
        "iam:TagOpenIDConnectProvider",
        "iam:UpdateOpenIDConnectProviderThumbprint"
      ],
      "Resource": "arn:aws:iam::*:oidc-provider/token.actions.githubusercontent.com"
    },
    {
      "Sid": "RegistrosDelProyecto",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:TagResource"
      ],
      "Resource": [
        "arn:aws:logs:us-east-2:*:log-group:/aws/lambda/costagas-*",
        "arn:aws:logs:us-east-2:*:log-group:/aws-glue/*"
      ]
    },
    {
      "Sid": "ListarServiciosDelProyecto",
      "Effect": "Allow",
      "Action": [
        "events:ListRules",
        "scheduler:ListSchedules",
        "scheduler:ListScheduleGroups",
        "sns:ListTopics",
        "sqs:ListQueues",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:GetMetricData",
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*"
    }
  ]
}
