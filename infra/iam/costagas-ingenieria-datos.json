{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StacksDelProyecto",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": "arn:aws:cloudformation:us-east-2:*:stack/costagas-*/*"
    },
    {
      "Sid": "ValidarYListarStacks",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ValidateTemplate", "cloudformation:ListStacks",
        "cloudformation:GetTemplateSummary"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LagoYCodigo",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::costagas-trujillo-lake-*", "arn:aws:s3:::costagas-trujillo-lake-*/*",
        "arn:aws:s3:::costagas-code-*", "arn:aws:s3:::costagas-code-*/*"
      ]
    },
    {
      "Sid": "ListarBuckets",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    },
    {
      "Sid": "FuncionesDelProyecto",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": "arn:aws:lambda:us-east-2:*:function:costagas-*"
    },
    {
      "Sid": "CapasYListado",
      "Effect": "Allow",
      "Action": [
        "lambda:GetLayerVersion", "lambda:ListFunctions", "lambda:ListLayers"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GlueJobsYCatalogo",
      "Effect": "Allow",
      "Action": "glue:*",
      "Resource": "*"
    },
    {
      "Sid": "AthenaWorkgroup",
      "Effect": "Allow",
      "Action": "athena:*",
      "Resource": "arn:aws:athena:us-east-2:*:workgroup/costagas-wg"
    },
    {
      "Sid": "ListarAthena",
      "Effect": "Allow",
      "Action": [
        "athena:ListWorkGroups", "athena:ListDataCatalogs", "athena:GetDataCatalog",
        "athena:ListDatabases", "athena:GetDatabase", "athena:ListTableMetadata",
        "athena:GetTableMetadata"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SalDeSeudonimizacion",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter", "ssm:GetParameters", "ssm:PutParameter", "ssm:DeleteParameter",
        "ssm:AddTagsToResource"
      ],
      "Resource": "arn:aws:ssm:us-east-2:*:parameter/costagas/*"
    },
    {
      "Sid": "ListarParametros",
      "Effect": "Allow",
      "Action": "ssm:DescribeParameters",
      "Resource": "*"
    },
    {
      "Sid": "RolesDeServicioDelProyecto",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:DeleteRole", "iam:GetRole", "iam:TagRole",
        "iam:UpdateAssumeRolePolicy", "iam:PutRolePolicy", "iam:DeleteRolePolicy",
        "iam:GetRolePolicy", "iam:ListRolePolicies", "iam:AttachRolePolicy",
        "iam:DetachRolePolicy", "iam:ListAttachedRolePolicies"
      ],
      "Resource": "arn:aws:iam::*:role/costagas-*"
    },
    {
      "Sid": "EntregarRolesSoloALambdaYGlue",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/costagas-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "lambda.amazonaws.com",
            "glue.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "PresupuestoYCostos",
      "Effect": "Allow",
      "Action": [
        "budgets:*", "ce:Get*", "ce:Describe*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LeerLogs",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups", "logs:DescribeLogStreams", "logs:GetLogEvents",
        "logs:FilterLogEvents", "logs:StartQuery", "logs:GetQueryResults"
      ],
      "Resource": "*"
    }
  ]
}
