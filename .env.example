# Copiar a .env y completar. .env NUNCA se versiona.

# --- Lago: local o S3 (prueba de sustitución, 2.3.1) ---
LAKE_URI=file://data/lake
# LAKE_URI=s3://costagas-trujillo-lake-<sufijo>
AWS_REGION=us-east-2
PROYECTO_SUFIJO=cambiar-por-sufijo-unico
ATHENA_WORKGROUP=costagas-wg
AWS_PROFILE=costagas

# --- Alertas de AWS Budgets (1 a 4 correos, separados por coma) ---
COSTAGAS_CORREOS=correo1@ejemplo.com,correo2@ejemplo.com

# --- Seudonimización (3.8.4). En AWS se lee de SSM: /costagas/seudonimo/sal ---
SEUDONIMO_SAL=
SSM_PARAM_SAL=/costagas/seudonimo/sal

# --- Alcance (1.6.1) ---
PLANTA=TRUJILLO
ANIO_INI=2016
ANIO_FIN=2024
ANIO_PILOTO=2020

# --- Procesamiento ---
SPARK_SHUFFLE_PARTITIONS=8
SALTING_BUCKETS=0
TAMANO_OBJETIVO_MB=128

# --- Calidad (Tabla 3.7) ---
META_PLACA_VALIDA=0.98
META_KG_EN_RANGO=0.99
TOL_TIPO_CAMBIO=0.01
TC_MIN=3.2
TC_MAX=4.2
MAX_FILAS_VACIAS=3000
KG_POR_GALON=2.04
KG_POR_LITRO=0.54

# --- Señales y modelos (4.2, 4.3) ---
UMBRAL_Z_MAD=3.5
TOP_K=20
TOL_PRECIO_S10=0.10
MERMA_TECNICA=0.005
UMBRAL_KPI_DIF=0.02
PRECIO_REF_KG=2.10
SEMILLA=42

# --- KPI 1 (H5): merma técnica asumida por el equipo (supuesto de trabajo, no dato de la empresa) ---
MERMA_TECNICA_PCT=0.005
MERMA_TECNICA_FUENTE=Supuesto de trabajo del equipo: 0.5 % de lo comprado
MERMA_TECNICA_ES_SUPUESTO=si

# --- Modelo S12 (4.3) ---
MADUREZ_DIAS=30
VENTANA_MEDIANA_DIAS=90
INICIO_EVAL_ADELANTE=2022-08
META_PRECISION=0.70
META_AUC=0.70
RECALL_MIN_RETADOR=0.50
REVISIONES_REENTRENO=20
RF_ARBOLES=100
RF_PROFUNDIDAD=6
BOOTSTRAP_REMUESTREOS=1000
PSI_UMBRAL=0.2
PSI_MIN_OBS=100
PSI_BINS=10

# --- Detector (Tabla 4.8h) ---
FALSAS_ALARMAS_ANIO=12
SEMILLAS_DETECTOR=100
LOTE_SEMILLAS=10

# --- Controles preventivos (Tabla 4.8i) ---
TOL_PRECIO_PAGO=0.05
