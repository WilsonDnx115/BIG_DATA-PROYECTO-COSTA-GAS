# Copiar a .env y completar. .env NUNCA se versiona.

# --- Lago: local o S3 (prueba de sustitución, 2.3.1) ---
LAKE_URI=file://data/lake
# LAKE_URI=s3://costagas-trujillo-lake-<sufijo>
AWS_REGION=us-east-2
PROYECTO_SUFIJO=cambiar-por-sufijo-unico
ATHENA_WORKGROUP=costagas-wg
AWS_PROFILE=costagas

# --- Alertas de AWS Budgets (1 a 4 correos, separados por coma) ---
COSTAGAS_CORREOS=correo1@ejemplo.com,correo2@ejemplo.com

# --- Seudonimización (3.8.4). En AWS se lee de SSM: /costagas/seudonimo/sal ---
SEUDONIMO_SAL=
SSM_PARAM_SAL=/costagas/seudonimo/sal

# --- Alcance (1.6.1) ---
PLANTA=TRUJILLO
ANIO_INI=2016
ANIO_FIN=2024
ANIO_PILOTO=2020

# --- Procesamiento ---
SPARK_SHUFFLE_PARTITIONS=8
SALTING_BUCKETS=0
TAMANO_OBJETIVO_MB=128

# --- Calidad (Tabla 3.7) ---
META_PLACA_VALIDA=0.98
META_KG_EN_RANGO=0.99
TOL_TIPO_CAMBIO=0.01

# --- Señales y modelos (4.2, 4.3) ---
UMBRAL_Z_MAD=3.5
TOP_K=20
TOL_PRECIO_S10=0.10
MERMA_TECNICA=0.005
PRECIO_REF_KG=2.10
SEMILLA=42
