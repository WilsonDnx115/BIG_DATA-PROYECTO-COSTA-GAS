    {
      "id": 1,
      "type": "stat",
      "title": "Unidades con semaforo",
      "description": "Filas de v_semaforo_unidades para los roles filtrados: una por unidad, en su periodo mas reciente.",
      "gridPos": {
        "x": 0,
