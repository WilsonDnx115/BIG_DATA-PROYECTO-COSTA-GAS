            "type": "grafana-athena-datasource",
            "uid": "${ds_athena}"
          },
          "format": 1,
          "rawSQL": "-- B07 · Semaforo de unidades antes del despacho (Tabla 4.8i, carril 2), desde v_semaforo_unidades.\n-- Una sola consulta por refresco (ADR 0016). La vista ya toma el periodo mas reciente de cada unidad,\n-- con granularidad semanal si existe, y cruza fact_serie con el ultimo mes de fact_unidad_mes.\nSELECT unidad_id,\n       rol,\n       semaforo,\n       granularidad,\n       periodo,\n       periodo_inicio,\n       kg_acumulados,\n       soles_acumulados,\n       senales\n  FROM costagas_gold.v_semaforo_unidades\n WHERE ('__all' IN (${rol:sqlstring}) OR rol IN (${rol:sqlstring}))\n ORDER BY CASE semaforo WHEN 'rojo' THEN 0 WHEN 'ambar' THEN 1 ELSE 2 END, unidad_id",
          "connectionArgs": {
            "region": "__default",
            "catalog": "__default",
            "database": "__default",
            "resultReuseEnabled": false
          }
        }
      ],
      "options": {
