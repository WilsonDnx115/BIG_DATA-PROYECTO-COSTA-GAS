    {
      "id": 1,
      "type": "stat",
      "title": "Alertas del mes",
      "description": "Filas de v_alerta en el mes elegido, para los roles filtrados.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 5
