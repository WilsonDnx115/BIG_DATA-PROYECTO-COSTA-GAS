      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "${ds_athena}"
          },
          "format": 1,
          "rawSQL": "-- B05 · Bandeja de alertas del mes elegido, desde v_alerta (fact_alerta + su ultima revision).\n-- Una sola consulta por refresco (ADR 0016). Filtra por anio y mes: v_alerta lee un hecho particionado.\n-- Sin nombres, DNI ni RUC: unidad_id es la placa normalizada y revisor_hash va seudonimizado.\nSELECT id_alerta,\n       senal,\n       tipo,\n       resolucion,\n       fecha,\n       unidad_id,\n       rol,\n       factura_id,\n       codigo_scop,\n       kg,\n       puntaje,\n       probabilidad,\n       grado_evidencia,\n       estado_revision,\n       nivel_evidencia,\n       revisado_en,\n       motivo,\n       fuentes,\n       anio,\n       mes\n  FROM costagas_gold.v_alerta\n WHERE anio = ${anio}\n   AND mes = ${mes}\n   AND ('__all' IN (${rol:sqlstring}) OR rol IN (${rol:sqlstring}))\n ORDER BY puntaje DESC NULLS LAST, id_alerta",
          "connectionArgs": {
            "region": "__default",
            "catalog": "__default",
            "database": "__default",
            "resultReuseEnabled": false
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "sin dato",
          "mappings": []
        },
        "overrides": []
      },
